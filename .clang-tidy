Checks: >
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  readability-*,
  portability-*,
  cppcoreguidelines-*,
  modernize-*,
  misc-*

WarningsAsErrors: ''
HeaderFilterRegex: '.*'
AnalyzeTemporaryDtors: false

CheckOptions:
  - key: readability-braces-around-statements.ShortStatementLines
    value: '1'